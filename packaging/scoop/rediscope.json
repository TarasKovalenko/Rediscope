{
    "version": "@VERSION@",
    "description": "Terminal UI client for Redis, Valkey, KeyDB and Dragonfly",
    "homepage": "https://github.com/TarasKovalenko/Rediscope",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/TarasKovalenko/Rediscope/releases/download/@TAG@/rediscope-@TAG@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256_WINDOWS_X64@"
        },
        "arm64": {
            "url": "https://github.com/TarasKovalenko/Rediscope/releases/download/@TAG@/rediscope-@TAG@-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA256_WINDOWS_ARM64@"
        }
    },
    "bin": "rediscope.exe",
    "checkver": {
        "github": "https://github.com/TarasKovalenko/Rediscope"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TarasKovalenko/Rediscope/releases/download/v$version/rediscope-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/TarasKovalenko/Rediscope/releases/download/v$version/rediscope-v$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
